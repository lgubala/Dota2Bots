X["items"] = {
	"item_magic_wand",
	"item_sange",
	"item_lifesteal",
	"item_butterfly",
	"item_assault",
	"item_heart",
	"item_abyssal_blade",
	"item_satanic",
	"item_moon_shard",
};

X["builds"] = {
	{3,1,3,2,3,4,3,1,1,1,4,2,2,2,4},
	{3,1,3,1,3,4,3,1,1,2,4,2,2,2,4}
}

X["skills"] = IBUtil.GetBuildPattern(
	  "normal", 
	  IBUtil.GetRandomBuild(X['builds']), skills, 
	  {1,4,6,7,2,3,5,9}, talents
);			

return X