X = {}

local IBUtil = require(GetScriptDirectory() .. "/ItemBuildUtility");
local npcBot = GetBot();
local talents = IBUtil.FillTalenTable(npcBot);
local skills = IBUtil.FillSkillTable(npcBot, {0,1,2,5});

X["items"] = {
	"item_magic_wand",
	"item_power_treads_str",
	"item_armlet",
	"item_sange",
	"item_aghanims_shard",
	"item_dragon_lance",
	"item_sange_and_yasha",
	"item_lifesteal",
	"item_black_king_bar",
	"item_satanic",
	"item_hurricane_pike",
	"item_heart",
	"item_ultimate_scepter_2",
	"item_assault",
	"item_moon_shard",
};			

X["builds"] = {
	{1,3,2,2,2,4,2,3,3,3,4,1,1,1,4},
	{1,3,3,2,3,4,3,1,1,1,4,2,2,2,4}
}

X["skills"] = IBUtil.GetBuildPattern(
	  "normal", 
	  IBUtil.GetRandomBuild(X['builds']), skills, 
	  {2,4,6,7,1,3,5,8}, talents
);

return X